FROM node:22-alpine AS office
WORKDIR /office
COPY integrations/pixel-agents/package*.json ./
COPY integrations/pixel-agents/server/package*.json server/
COPY integrations/pixel-agents/webview-ui/package*.json webview-ui/
RUN npm ci
COPY integrations/pixel-agents/ ./
RUN npm run build --workspace webview-ui -- --config vite.live.config.ts

FROM node:22-alpine AS build
WORKDIR /app
COPY apps/trading-company-web/package*.json ./
RUN npm ci
COPY apps/trading-company-web/ ./
COPY --from=office /office/dist/live-office ./public/office
COPY --from=office /office/LICENSE ./public/office/LICENSE.txt
RUN npm run build

FROM node:22-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app ./
EXPOSE 3001
CMD ["npm", "start", "--", "--hostname", "0.0.0.0", "--port", "3001"]
