APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
# Hosted AI-company employees. Missing key makes the company fail closed with no trade.
# This template is safe to commit; never commit a real .env file or API key.
# Provide the real key through your environment or deployment secret store.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
# Forward Sandbox is the main account; the legacy company does not auto-start.
FORWARD_FUNDING_ENABLED=true
AI_COMPANY_ENABLED=false
# Simulated, one-time initial capital. Must match an existing account's saved seed.
# Use 0 for a new salary-only Sandbox. Never change this to repair/reset a ledger.
SANDBOX_INITIAL_CAPITAL=100000
