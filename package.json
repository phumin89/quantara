{
  "name": "quantara",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @quantara/web",
    "dev:market-data": "dotnet run --project services/market-data/MarketData.Api/MarketData.Api.csproj",
    "dev:api": "dotnet run --project services/portfolio/Portfolio.Api/Portfolio.Api.csproj",
    "build": "npm run build --workspace @quantara/web",
    "start": "npm run start --workspace @quantara/web",
    "lint": "npm run lint --workspace @quantara/web",
    "typecheck": "npm run typecheck --workspace @quantara/web",
    "check": "npm run check --workspace @quantara/web",
    "test:ui": "node tools/verify-shell.cjs",
    "test:crypto": "node tools/verify-crypto.cjs",
    "test:contracts": "node tools/verify-contracts.cjs",
    "test:architecture": "dotnet run --project tests/Architecture.Checks/Architecture.Checks.csproj && node tools/verify-architecture.cjs",
    "format": "prettier --write apps/web tools .vscode package.json",
    "format:check": "prettier --check apps/web tools .vscode package.json",
    "test:editor": "dotnet run --project tests/Analyzer.Checks/Analyzer.Checks.csproj && node tools/verify-editor-rules.cjs"
  },
  "devDependencies": {
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0"
  }
}
